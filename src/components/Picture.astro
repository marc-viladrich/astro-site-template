---
// Dünne Hülle um Astro <Image>: erzwingt Alt-Text und Maße aus dem Schema,
// optimiert Remote-Bilder vom zentralen Medienspeicher beim Build.
import { Image } from 'astro:assets';
interface Props { src: string; alt: string; width: number; height: number; sizes?: string; loading?: 'lazy' | 'eager'; class?: string }
const { src, alt, width, height, sizes = '(min-width: 48rem) 50vw, 100vw', loading = 'lazy', class: cls } = Astro.props;
---
<Image src={src} alt={alt} width={width} height={height} sizes={sizes} loading={loading} class={cls} widths={[480, 768, 1200, 1600].filter((w) => w <= width)} />
