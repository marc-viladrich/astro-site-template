---
import Picture from '../Picture.astro';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'logoBar' }> & { index: number };
const { headline, logos, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
---
<section class="section section--tight" aria-labelledby={headline ? id : undefined}>
  <div class="wrap">
    {headline && <H id={id} class="logos__headline">{headline}</H>}
    <ul class="logos" role="list">
      {logos.map((l) => {
        const content = l.image
          ? <Picture {...l.image} alt={l.name} class="logos__img" sizes="10rem" />
          : <span class="logos__name">{l.name}</span>;
        return <li>{l.href ? <a href={l.href}>{content}</a> : content}</li>;
      })}
    </ul>
  </div>
</section>
