---
import { getCollection, render } from 'astro:content';
import type { Section } from '../../content.config';
type Props = Extract<Section, { type: 'faq' }> & { index: number };
const { headline = 'Häufige Fragen', tags, limit, index } = Astro.props;
const id = `s${index}-h`;
const H = index === 0 ? 'h1' : 'h2';
let entries = (await getCollection('faq', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
if (tags?.length) entries = entries.filter((e) => e.data.tags.some((t) => tags.includes(t)));
if (limit) entries = entries.slice(0, limit);
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
---
<section class="section section--band" aria-labelledby={id}>
  <div class="wrap">
    <H id={id}>{headline}</H>
    <div class="measure">
      {rendered.map(({ e, Content }) => (
        <details>
          <summary>{e.data.question}</summary>
          <div class="prose"><Content /></div>
        </details>
      ))}
    </div>
  </div>
</section>
